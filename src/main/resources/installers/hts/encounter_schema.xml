<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <changeSet id="create_hts_encounter_V2" author="Emmanuel Nnajiofor">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="hts_encounter" schemaName="public"/>
            </not>
        </preConditions>
        <createTable tableName="hts_encounter">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="uuid" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="person_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_hts_encounter_person" references="patient_person(id)"/>
            </column>
            <column name="client_code" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="date_of_visit" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="facility_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="setting" type="VARCHAR(50)"/>
            <column name="data" type="JSONB"/>
            <column name="archived" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(50)"/>
            <column name="date_created" type="TIMESTAMP WITHOUT TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="modified_by" type="VARCHAR(50)"/>
            <column name="last_modified_date" type="TIMESTAMP WITHOUT TIME ZONE"/>
        </createTable>

        <createIndex indexName="idx_hts_encounter_person" tableName="hts_encounter">
            <column name="person_id"/>
        </createIndex>
        <createIndex indexName="idx_hts_encounter_client_code" tableName="hts_encounter">
            <column name="client_code"/>
        </createIndex>
        <createIndex indexName="idx_hts_encounter_date_visit" tableName="hts_encounter">
            <column name="date_of_visit"/>
        </createIndex>
        <createIndex indexName="idx_hts_encounter_facility" tableName="hts_encounter">
            <column name="facility_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>