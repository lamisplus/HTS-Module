<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <!-- ============================================================ -->
    <!-- hts_ict_encounter                                            -->
    <!-- ============================================================ -->
    <changeSet id="create_ict_encounter_v3_05152602" author="Emmanuel Nnajiofor">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="hts_ict_encounter" schemaName="public"/>
            </not>
        </preConditions>
        <comment>
            V3 — Fresh install only.
            Changes from V2:
            - uuid:        VARCHAR(36) → UUID with gen_random_uuid() default (DB-generated)
            - person_id:   renamed to patient_id
            - patient_uuid: new UUID column (no FK because patient_person.uuid may be varchar)
            - facility_id: now BIGINT, FK → base_organisation_unit(id) (reverted from UUID)
            - archived:    INT → BOOLEAN
        </comment>

        <createTable tableName="hts_ict_encounter">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="uuid" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints nullable="false" unique="true"/>
            </column>

            <!-- Renamed from person_id -->
            <column name="patient_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_ict_encounter_patient"
                             references="patient_person(id)"/>
            </column>

            <column name="patient_uuid" type="UUID">
                <constraints nullable="true"/>
            </column>

            <column name="hts_encounter_id" type="BIGINT">
                <constraints nullable="true"
                             foreignKeyName="fk_ict_encounter_hts"
                             references="hts_encounter(id)"/>
            </column>

            <column name="facility_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_ict_encounter_facility"
                             references="base_organisation_unit(id)"/>
            </column>

            <column name="date_of_service" type="DATE">
                <constraints nullable="false"/>
            </column>

            <column name="setting" type="VARCHAR(100)"/>
            <column name="client_category" type="VARCHAR(100)"/>
            <column name="offered_pns" type="VARCHAR(10)"/>
            <column name="accepted_pns" type="VARCHAR(10)"/>
            <column name="data" type="JSONB"/>

            <column name="archived" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <column name="created_by" type="VARCHAR(255)"/>
            <column name="date_created" type="TIMESTAMP WITHOUT TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="modified_by" type="VARCHAR(255)"/>
            <column name="date_modified" type="TIMESTAMP WITHOUT TIME ZONE"/>
        </createTable>

        <createIndex indexName="idx_hts_ict_encounter_patient" tableName="hts_ict_encounter">
            <column name="patient_id"/>
        </createIndex>
        <createIndex indexName="idx_hts_ict_encounter_patient_uuid" tableName="hts_ict_encounter">
            <column name="patient_uuid"/>
        </createIndex>
        <createIndex indexName="idx_hts_ict_encounter_hts" tableName="hts_ict_encounter">
            <column name="hts_encounter_id"/>
        </createIndex>
        <createIndex indexName="idx_hts_ict_encounter_facility" tableName="hts_ict_encounter">
            <column name="facility_id"/>
        </createIndex>
        <createIndex indexName="idx_hts_ict_encounter_date_service" tableName="hts_ict_encounter">
            <column name="date_of_service"/>
        </createIndex>
    </changeSet>

    <!-- ============================================================ -->
    <!-- hts_ict_contact                                              -->
    <!-- ============================================================ -->
    <changeSet id="create_ict_contact_v3_05152602" author="Emmanuel Nnajiofor">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="hts_ict_contact" schemaName="public"/>
            </not>
        </preConditions>
        <comment>
            V3 — Fresh install only.
            Changes from V2:
            - uuid:               VARCHAR(36) → UUID with gen_random_uuid() default (DB-generated)
            - contact_id:         renamed to contact_code
            - contact_age:        REMOVED (item 5)
            - contact_age_group:  REMOVED (item 5)
            - archived:           INT → BOOLEAN
            - contact_* prefix/suffix columns renamed (item 6):
            firstname_of_contact  → first_name
            middlename_of_contact → middle_name
            surname_of_contact    → surname
            contact_sex           → sex
            contact_phone         → phone
            contact_address       → address
            contact_art_clinic    → art_clinic
            contact_on_art        → on_art
            - contact_id kept as contact_code (item 7)
            - relationship_to_index, same_address_as_index,
            notification_method, follow_up_location, attempts,
            known_hiv_positive, hiv_test_result, date_tested_hiv,
            date_enrolled_art, enrolled_in_ovc, date_enrolled_ovc,
            ovc_id — unchanged (no contact prefix/suffix)
        </comment>

        <createTable tableName="hts_ict_contact">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="uuid" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="ict_encounter_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_ict_contact_encounter"
                             references="hts_ict_encounter(id)"/>
            </column>

            <!-- Renamed from contact_id (item 7) -->
            <column name="contact_code" type="VARCHAR(100)"/>

            <!-- Renamed: firstname_of_contact → first_name (item 6) -->
            <column name="first_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <!-- Renamed: middlename_of_contact → middle_name (item 6) -->
            <column name="middle_name" type="VARCHAR(255)"/>

            <!-- Renamed: surname_of_contact → surname (item 6) -->
            <column name="surname" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="relationship_to_index" type="VARCHAR(100)"/>

            <!-- Renamed: contact_sex → sex (item 6) -->
            <column name="sex" type="VARCHAR(20)"/>

            <!-- contact_age_group REMOVED (item 5) -->
            <!-- contact_age       REMOVED (item 5) -->

            <!-- Renamed: contact_phone → phone (item 6) -->
            <column name="phone" type="VARCHAR(20)"/>

            <column name="same_address_as_index" type="BOOLEAN" defaultValueBoolean="false"/>

            <!-- Renamed: contact_art_clinic → art_clinic (item 6) -->
            <column name="art_clinic" type="TEXT"/>

            <!-- Renamed: contact_address → address (item 6) -->
            <column name="address" type="TEXT"/>

            <column name="notification_method" type="VARCHAR(100)"/>
            <column name="follow_up_location" type="VARCHAR(100)"/>
            <column name="attempts" type="INT" defaultValueNumeric="0"/>
            <column name="known_hiv_positive" type="VARCHAR(10)"/>
            <column name="hiv_test_result" type="VARCHAR(50)"/>
            <column name="date_tested_hiv" type="DATE"/>
            <column name="date_enrolled_art" type="DATE"/>

            <!-- Renamed: contact_on_art → on_art (item 6) -->
            <column name="on_art" type="VARCHAR(40)"/>

            <column name="enrolled_in_ovc" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="date_enrolled_ovc" type="DATE"/>
            <column name="ovc_id" type="VARCHAR(100)"/>

            <column name="archived" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <column name="created_by" type="VARCHAR(255)"/>
            <column name="date_created" type="TIMESTAMP WITHOUT TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="modified_by" type="VARCHAR(255)"/>
            <column name="date_modified" type="TIMESTAMP WITHOUT TIME ZONE"/>
        </createTable>

        <createIndex indexName="idx_hts_ict_contact_encounter" tableName="hts_ict_contact">
            <column name="ict_encounter_id"/>
        </createIndex>
        <createIndex indexName="idx_hts_ict_contact_known_hiv" tableName="hts_ict_contact">
            <column name="known_hiv_positive"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>