<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <!-- ── ict_encounter ────────────────────────────────────────────────────── -->
    <changeSet id="create_ict_encounter_table" author="lamisplus">
        <createTable tableName="ict_encounter">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="uuid" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>

            <!-- Owning person — always present -->
            <column name="person_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_ict_encounter_person"
                             references="patient_person(id)"/>
            </column>

            <!--
                Link to the HTS encounter that triggered this ICT.
                Nullable because ICT can also be opened from the ART module
                (Virally Unsuppressed / RTT) without a same-session HTS encounter.
            -->
            <column name="hts_encounter_id" type="BIGINT">
                <constraints nullable="true"
                             foreignKeyName="fk_ict_encounter_hts"
                             references="hts_encounter(id)"/>
            </column>

            <column name="facility_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="date_of_service" type="DATE">
                <constraints nullable="false"/>
            </column>

            <!-- Stored as a column for quick filtering; also duplicated into data JSONB -->
            <column name="setting" type="VARCHAR(100)"/>
            <column name="client_category" type="VARCHAR(100)"/>
            <column name="offered_pns" type="VARCHAR(10)"/>
            <column name="accepted_pns" type="VARCHAR(10)"/>

            <!--
                Overflow JSONB: stores all remaining Section A fields
                (facilitySetting, communityEntryPoint, artClinic, clientCategoryOther,
                 index client demographics snapshot, etc.) so the schema stays stable
                 as the form evolves.
            -->
            <column name="data" type="JSONB"/>

            <column name="archived" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="date_created" type="TIMESTAMP WITHOUT TIME ZONE"
                    defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="modified_by" type="VARCHAR(255)"/>
            <column name="last_modified_date" type="TIMESTAMP WITHOUT TIME ZONE"/>
        </createTable>

        <createIndex indexName="idx_ict_encounter_person" tableName="ict_encounter">
            <column name="person_id"/>
        </createIndex>
        <createIndex indexName="idx_ict_encounter_hts" tableName="ict_encounter">
            <column name="hts_encounter_id"/>
        </createIndex>
        <createIndex indexName="idx_ict_encounter_facility" tableName="ict_encounter">
            <column name="facility_id"/>
        </createIndex>
        <createIndex indexName="idx_ict_encounter_date_service" tableName="ict_encounter">
            <column name="date_of_service"/>
        </createIndex>
    </changeSet>

    <!-- ── ict_contact ──────────────────────────────────────────────────────── -->
    <changeSet id="create_ict_contact_table" author="lamisplus">
        <createTable tableName="ict_contact">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="uuid" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="ict_encounter_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_ict_contact_encounter"
                             references="ict_encounter(id)"/>
            </column>

            <!-- Frontend-generated human-readable contact ID, e.g. ICT-CLIENT001-1-abc -->
            <column name="contact_id" type="VARCHAR(100)"/>

            <!-- Core contact fields — stored as columns for reporting queries -->
            <column name="name_of_contact" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="relationship_to_index" type="VARCHAR(100)"/>
            <column name="contact_sex" type="VARCHAR(20)"/>
            <column name="contact_age_group" type="VARCHAR(20)"/>
            <column name="contact_phone" type="VARCHAR(20)"/>
            <column name="contact_address" type="TEXT"/>
            <column name="same_address_as_index" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="notification_method" type="VARCHAR(100)"/>
            <column name="follow_up_location" type="VARCHAR(100)"/>
            <column name="attempts" type="INT" defaultValueNumeric="0"/>
            <column name="known_hiv_positive" type="VARCHAR(10)"/>
            <column name="hiv_test_result" type="VARCHAR(20)"/>
            <column name="date_tested_hiv" type="DATE"/>
            <column name="date_enrolled_art" type="DATE"/>
            <column name="enrolled_in_ovc" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="date_enrolled_ovc" type="DATE"/>
            <column name="ovc_id" type="VARCHAR(100)"/>

            <!-- Overflow for future fields -->
            <column name="data" type="JSONB"/>

            <column name="archived" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="date_created" type="TIMESTAMP WITHOUT TIME ZONE"
                    defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="modified_by" type="VARCHAR(255)"/>
            <column name="last_modified_date" type="TIMESTAMP WITHOUT TIME ZONE"/>
        </createTable>

        <createIndex indexName="idx_ict_contact_encounter" tableName="ict_contact">
            <column name="ict_encounter_id"/>
        </createIndex>
        <createIndex indexName="idx_ict_contact_known_hiv" tableName="ict_contact">
            <column name="known_hiv_positive"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
