<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <changeSet id="create_hivst_encounter_v1" author="developer">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="hivst_encounter" schemaName="public"/>
            </not>
        </preConditions>
        <comment>Creates hivst_encounter table identical to hts_encounter but without pmtct_hts.</comment>

        <createTable tableName="hivst_encounter">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="uuid" type="VARCHAR(50)" defaultValueComputed="gen_random_uuid()::text">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="visit_id" type="VARCHAR(36)" defaultValueComputed="gen_random_uuid()::text">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="patient_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_hivst_encounter_patient" references="patient_person(id)"/>
            </column>
            <column name="patient_uuid" type="VARCHAR(50)"/>
            <column name="client_code" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="date_of_visit" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="facility_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_hivst_encounter_facility" references="base_organisation_unit(id)"/>
            </column>
            <column name="setting" type="VARCHAR(200)"/>
            <column name="observation" type="JSONB"/>
            <column name="archived" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="source" type="VARCHAR(200)" defaultValue="Web"/>
            <column name="longitude" type="VARCHAR(200)"/>
            <column name="latitude" type="VARCHAR(200)"/>
            <column name="created_by" type="VARCHAR(200)"/>
            <column name="date_created" type="TIMESTAMP WITHOUT TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="modified_by" type="VARCHAR(200)"/>
            <column name="date_modified" type="TIMESTAMP WITHOUT TIME ZONE"/>
        </createTable>

        <createIndex indexName="idx_hivst_encounter_patient" tableName="hivst_encounter">
            <column name="patient_id"/>
        </createIndex>
        <createIndex indexName="idx_hivst_encounter_patient_uuid" tableName="hivst_encounter">
            <column name="patient_uuid"/>
        </createIndex>
        <createIndex indexName="idx_hivst_encounter_client_code" tableName="hivst_encounter">
            <column name="client_code"/>
        </createIndex>
        <createIndex indexName="idx_hivst_encounter_date_visit" tableName="hivst_encounter">
            <column name="date_of_visit"/>
        </createIndex>
        <createIndex indexName="idx_hivst_encounter_facility" tableName="hivst_encounter">
            <column name="facility_id"/>
        </createIndex>
        <!-- Composite index for grid performance -->
        <createIndex indexName="idx_hivst_encounter_grid_latest" tableName="hivst_encounter">
            <column name="facility_id"/>
            <column name="archived"/>
            <column name="patient_uuid"/>
            <column name="id" descending="true"/>
        </createIndex>
    </changeSet>

    <changeSet id="create_hivst_result_v1" author="developer">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="hivst_result" schemaName="public"/>
            </not>
        </preConditions>
        <comment>Creates hivst_result table with one-to-one relationship to encounter.</comment>

        <createTable tableName="hivst_result">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="uuid" type="VARCHAR(50)" defaultValueComputed="gen_random_uuid()::text">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="encounter_id" type="BIGINT">
                <constraints nullable="false" unique="true" foreignKeyName="fk_hivst_result_encounter" references="hivst_encounter(id)"/>
            </column>
            <column name="number_of_kits" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="reactive_gt_15" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="reactive_le_15" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="archived" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(200)"/>
            <column name="date_created" type="TIMESTAMP WITHOUT TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="modified_by" type="VARCHAR(200)"/>
            <column name="date_modified" type="TIMESTAMP WITHOUT TIME ZONE"/>
        </createTable>

        <createIndex indexName="idx_hivst_result_encounter" tableName="hivst_result">
            <column name="encounter_id"/>
        </createIndex>
        <createIndex indexName="idx_hivst_result_archived" tableName="hivst_result">
            <column name="archived"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>